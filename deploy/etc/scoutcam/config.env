# ScoutCam Configuration
# Edit this file to change streaming settings

# Active profile (720p30, 720p60, 1080p30, 1080p50, 1080p60)
# Pi 5 (no hardware H.264 encoder) software-encodes both streams. Measured dual-cam
# load (two IMX708): 720p30=28% CPU, 720p60=42%, 1080p30=49%, 1080p50=79% (near limit),
# 1080p60=unstable (one camera starves). 720p60 is the recommended default for tracking.
PROFILE=720p60

# --- Camera count ---
# 1 = single camera (Pi 4B / HQ Cam IMX477) -> uses STREAM_PATH below.
# 2 = dual camera (Pi 5, two Camera Module 3 / IMX708) -> uses STREAM_PATH0/1.
CAMERA_COUNT=2

# RTSP Server Settings
RTSP_PORT=8554

# Single-camera path (used only when CAMERA_COUNT=1)
STREAM_PATH=cam

# Dual-camera paths and libcamera indices (used when CAMERA_COUNT>=2)
# Indices come from `rpicam-hello --list-cameras` (0 and 1).
STREAM_PATH0=cam0
STREAM_PATH1=cam1
CAMERA0_ID=0
CAMERA1_ID=1

# H.264 codec for the rpiCamera source.
# auto       = hardware encoder on Pi 4B, software H.264 on Pi 5 (no HW encoder)
# softwareH264 = force software (libx264); hardwareH264 = force hardware
RPI_CAMERA_CODEC=auto

# Camera Tuning (optional overrides)
# Leave commented to use auto settings.
# IMX708 (Camera Module 3) autofocus: auto | manual | continuous
#RPI_CAMERA_AF_MODE=continuous
# Fixed shutter in microseconds. Freezes fast motion AND guarantees a consistent
# frame rate: with auto-exposure, a dim scene stretches frame duration and caps fps
# (measured ~26fps in office light). 6000 (6ms) holds full fps up to ~120 and gives a
# bright, sharp image in arena/office lighting. Raise for dim rooms (lowers max fps).
SHUTTER_SPEED=6000
#ANALOG_GAIN=1.0
#AWB_MODE=auto

# Recording Settings
# Recording targets a single RTSP path and is not supported in dual-camera mode
# (the single `cam` path does not exist when CAMERA_COUNT>=2). Keep disabled here.
RECORDING_ENABLED=false
RECORDING_PATH=/mnt/usb/recordings
SEGMENT_DURATION=300

# Advanced Settings
LOG_LEVEL=info
RESTART_DELAY=5

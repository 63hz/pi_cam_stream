# ScoutCam Configuration
# Edit this file to change streaming settings

# Active profile (720p60, 1080p30, 720p120, 1080p50, 1080p40)
# 720p60 and 1080p30 use MediaMTX rpiCamera source (recommended)
# 1080p50/720p120/1080p40 are legacy rpicam-vid profiles (Pi 4B can't hit target fps)
PROFILE=720p60

# RTSP Server Settings
RTSP_PORT=8554
STREAM_PATH=cam

# Camera Tuning (optional overrides)
# Leave commented to use auto settings
SHUTTER_SPEED=1000
#ANALOG_GAIN=1.0
#AWB_MODE=auto

# Recording Settings
RECORDING_ENABLED=true
RECORDING_PATH=/mnt/usb/recordings
SEGMENT_DURATION=300

# Advanced Settings
LOG_LEVEL=info
RESTART_DELAY=5

# 1080p60 Profile - Full HD, 60fps (Pi 5 software H.264) - NOT RECOMMENDED for dual
# The IMX708 1080p sensor mode caps ~56fps, so 60 is unreachable, and under dual-camera
# load one stream gets starved (measured cam0~27 / cam1~51 fps). Use 1080p50 instead.

WIDTH=1920
HEIGHT=1080
FRAMERATE=60
BITRATE=12000000
IDR_PERIOD=60

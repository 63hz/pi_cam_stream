# 720p30 Profile - HD, 30fps
# Best for: Dual-camera Pi 5 (software H.264 x2), safe sustainable starting point
# Pi 5 has no hardware H.264 encoder; both streams are libx264-encoded on the CPU.
# Lowest encode load of the sweep - step up to 720p60/1080p30 if CPU has headroom.

WIDTH=1280
HEIGHT=720
FRAMERATE=30
BITRATE=4000000
IDR_PERIOD=30
